# Copy to .env and fill in. Never commit .env or your key files.
# Keys can also be pasted in the dashboard (Settings) - that is the easier way.

# --- Demo exchange (fake money) ---
KALSHI_API_KEY_ID=your-demo-api-key-id
# Path to the PEM private key Kalshi gave you (Ed25519 or RSA)
KALSHI_PRIVATE_KEY_PATH=secrets/kalshi_demo.key

# --- Production exchange (real money) - separate key pair, only needed for Live ---
# KALSHI_LIVE_API_KEY_ID=your-production-api-key-id
# KALSHI_LIVE_PRIVATE_KEY_PATH=secrets/kalshi_live.key

# Starting mode on the very first run: demo (default) | paper
# Live can only be selected in the dashboard, after typing the unlock phrase.
KALSHI_ENV=demo
